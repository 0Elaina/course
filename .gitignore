# ==========================================
# 课程资源目录规则（适用于所有课程的 03-course-resources）
# 教材、课件等大文件由用户本地自存，不纳入 Git 版本控制
# ==========================================
**/03-course-resources/*
!**/03-course-resources/.gitkeep
!**/03-course-resources/*.md

# ==========================================
# 常见大型文件与媒体资源（防止提交超过 GitHub 限制的大文件）
# ==========================================
*.pdf
*.zip
*.rar
*.7z
*.tar
*.tar.*
*.iso
*.dmg
*.exe
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.pptx
*.ppt
*.docx
*.doc

# ==========================================
# 系统与编辑器缓存
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp


# 忽略所有层级下的 .venv 文件夹
.venv/

# 忽略 Python 缓存文件
__pycache__/
*.py[cod]
*$py.class

# 忽略 uv 的锁文件和缓存（可选，通常 uv.lock 建议提交，但看个人习惯）
# uv.lock
# .uv/

# 忽略 IDE 配置文件夹
.idea/
.vscode/

# 忽略系统文件（如 Mac 的 .DS_Store 或 Windows 的 Thumbs.db）
.DS_Store
Thumbs.db